NODE_ENV=development
LOGS_TYPE=development

PORT=30100

# Allowed CORS origins, comma-separated (e.g. https://app.asdf.it,https://asdf.it).
# Leave empty to allow all origins (dev default).
CORS_ORIGINS=

SEND_EMAILS= # nothing for false, anything else for true
EMAIL_HOST="sandbox.smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER=username
EMAIL_PASSWORD=password
